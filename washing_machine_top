module washing_machine_top(
    input        CLK100MHZ,
    input        CPU_RESETN,
    input        BTNC,
    input        mode,
    output [6:0] LED
);
    wire rst = ~CPU_RESETN;     
    wire clean_button;
 
    debouncer u_debouncer (
        .clk(CLK100MHZ),
        .rst(rst),
        .button(BTNC),
        .debounced_button(clean_button)
    );
 
    washing_machine_fsm u_fsm (
        .clk(CLK100MHZ),
        .rst(rst),
        .button(clean_button),
        .led(LED),
        .mode(mode)
    );
endmodule
