module debouncer(
    input clk,
    input rst,
    input button,
    output reg debounced_button
);

    reg [31:0] counter;

    always @(posedge clk) begin
        if (rst) begin
            counter <= 0;
            debounced_button <= 0;
        end
        else begin
            if (button != debounced_button) begin
                counter <= counter + 1;

                if (counter >= 32'd1_000_000) begin
                    debounced_button <= button;
                    counter <= 0;
                end
            end
            else begin
                counter <= 0;
            end
        end
    end

endmodule
